# PostgreSQL (Neon, Vercel Postgres, Supabase, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Conexión directa sin pooler (requerido por Prisma migrate/db push con Neon)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Secreto para sesiones JWT (genera uno aleatorio en producción)
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

NEXT_PUBLIC_APP_NAME="La Dicha"
