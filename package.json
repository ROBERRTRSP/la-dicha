{
  "name": "la-dicha",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "vercel-build": "prisma validate && prisma generate && prisma db push --skip-generate --accept-data-loss && tsx prisma/seed.ts && node scripts/install-la-dicha-art.mjs && node scripts/fetch-logos.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:validate": "prisma validate",
    "art:install": "node scripts/install-la-dicha-art.mjs",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "logos:fetch": "node scripts/fetch-logos.mjs",
    "slots:optimize-pngs": "node scripts/optimize-slot-pngs.mjs",
    "test:slot-motion": "tsx scripts/test-slot-motion.ts",
    "test:slot-audit": "node scripts/verify-slot-audit.mjs",
    "test:slot-production": "node scripts/test-slot-production.mjs",
    "test:slot-1000": "tsx scripts/test-slot-1000-spins.ts",
    "test:roulette-daily-cap": "tsx scripts/test-roulette-daily-cap.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "html5-qrcode": "^2.3.8",
    "jose": "^6.0.11",
    "next": "^15.3.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.21",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.3",
    "prisma": "^6.19.0",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
